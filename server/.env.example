# Server Configuration (PORT is automatically assigned by Render in production)
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String (MANDATORY in production on Render)
# Important for Render: Whitelist IP 0.0.0.0/0 in MongoDB Atlas > Network Access
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_todo?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Client URL for CORS (e.g., https://your-app.onrender.com in production)
CLIENT_URL=http://localhost:3000
